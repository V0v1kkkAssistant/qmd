server {
  listen 8080;
  server_name _;
  client_max_body_size 10m;

  # Simple bearer-token gate for all API paths.
  if ($http_authorization != "Bearer ${QMD_GATEWAY_API_KEY}") {
    return 401;
  }

  location = /v1/embeddings {
    proxy_pass http://api-embed:8000/v1/embeddings;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location = /v1/chat/completions {
    proxy_pass http://api-generate:8000/v1/chat/completions;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # QMD tries /v1/rerank first, then falls back to /rerank (configurable).
  location = /v1/rerank {
    proxy_pass http://api-rerank:7997/rerank;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location = /rerank {
    proxy_pass http://api-rerank:7997/rerank;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}
